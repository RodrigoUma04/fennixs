DB_USERNAME=changeme
DB_PASSWORD=changeme
JWT_SECRET=changeme                         # Required, no default. Long random string used to sign tokens

# --- Optional environment variables ---

GATEWAY_PORT=80                             # Defaults to 80
COOKIE_SECURE=false                         # Defaults to false. Set true when serving over HTTPS
ALLOW_REGISTRATION=false                    # Defaults to false
TIMEZONE=Europe/Brussels                    # Defaults to UTC
HEALTH_SHOW_DETAILS=always                  # Defaults to never
LOGGING_STRUCTURED_FORMAT_CONSOLE=logstash  # Defaults to none
AUTH_MEMORY_LIMIT=512M                      # Defaults to 512M. Memory cap for the auth service
API_MEMORY_LIMIT=512M                       # Defaults to 512M. Memory cap for the core API service
