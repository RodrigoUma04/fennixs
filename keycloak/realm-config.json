{
  "realm": "fennixs",
  "enabled": true,
  "displayName": "Fennixs",
  "attributes": {
    "fennixs.config.version": "1"
  },
  "registrationAllowed": false,
  "sslRequired": "${FENNIXS_SSL_REQUIRED:external}",
  "ssoSessionIdleTimeout": 1209600,
  "ssoSessionMaxLifespan": 2592000,
  "revokeRefreshToken": true,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 2592000,
  "actionTokenGeneratedByUserLifespan": 600,
  "actionTokenGeneratedByAdminLifespan": 3600,
  "bruteForceProtected": true,
  "failureFactor": 30,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "passwordPolicy": "length(12) and notUsername(undefined) and notEmail(undefined) and passwordHistory(3)",
  "clients": [
    {
      "clientId": "fennixs-core-api",
      "enabled": true,
      "secret": "${CORE_CLIENT_SECRET}",
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["http://localhost:8081/login/oauth2/code/oidc"],
      "webOrigins": [],
      "defaultClientScopes": ["acr", "basic", "email"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8081",
        "backchannel.logout.url": "http://localhost:8081/logout/connect/back-channel/oidc",
        "backchannel.logout.session.required": "true",
        "client.secret.authentication.allowed.method": "client_secret_basic"
      }
    }
  ]
}
